{
  "ConnectionStrings": {
    "SqlConnection": "Server=(LocalDB)\\MSSQLLocalDB;Database=ProjectManagerDB;Integrated Security=True;",
    "Redis": "Host:Port,user=user,password=password,ssl=true,abortConnect=false"
  }, 
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "ArslanProjectManager",
    "Audience": "ArslanProjectManagerUser",
    "SecurityKey": "type_your_secret_key_here_to_use_in_JWT",
    "ExpirationInMinutes": 60
  },
  "RefreshToken": {
    "ExpirationInDays": 7
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowMinutes": 1
  }
}
